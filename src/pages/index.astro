---
import Layout from '../layouts/Layout.astro';
import { App } from '../components/App.jsx';

import { getCollection, getEntry } from 'astro:content';

const quotes = await Promise.all((await getCollection('quotations')).map(async quote => ({
	...quote,
	data: {
		...quote.data,
		sourceEntry: await getEntry(quote.data.source_guid),
		codeEntries: await Promise.all(
			quote.data.Coding.map(code => getEntry(code.CodeRef.attrs.targetGUID))
		),
	},
})));

const codes = await getCollection('codes');

const codesWithQuotes = codes.map(code => ({
	...code,
	quotes: quotes.filter(quote => quote.data.codeEntries.some(coding => coding.data.guid === code.data.guid)),
}));
const nonemptyCodes = codesWithQuotes.filter(code => code.quotes.length > 0).map(code => ({
	...code,
	quotes: undefined,
}));

const sources = await getCollection('sources');

---

<Layout title="scSTAR">
	<App
		client:load
		codes={codes}
		nonemptyCodes={nonemptyCodes}
		sources={sources}
		quotes={quotes}
	/>
</Layout>

<style is:global>
	main {
		display: flex;
		flex-direction: row;
	}
	.sidebar {
		flex-basis: 20%;
		height: 100vh;
		overflow-y: scroll;
		box-sizing: border-box;
	}
	.sidebar-inner {
		padding: 5px;
	}
	.cards-container {
		flex-basis: 80%;
		height: 100vh;
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.grid-container {
		flex: 1;
		min-height: 0;
	}
	.chart-container {
		flex: 0 0 auto;
		max-height: 45vh;
		overflow-y: auto;
		padding: 4px 8px;
		border-bottom: 1px solid rgba(0, 0, 0, 0.2);
		background-color: #fcfcfb;
	}
	.chart-title {
		margin: 2px 0 4px 0;
		font-size: 13px;
		font-weight: 600;
	}
	.chart-empty {
		font-size: 12px;
		color: #52514e;
	}
	.chart-tooltip {
		position: absolute;
		pointer-events: none;
		background: white;
		border: 1px solid rgba(0, 0, 0, 0.2);
		border-radius: 4px;
		padding: 4px 8px;
		font-size: 12px;
		color: #0b0b0b;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
		white-space: nowrap;
		z-index: 10;
	}
	.quote-cards {
		display: grid;
		grid-gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		box-sizing: border-box;
	}
	.link-card {
		list-style-type: none;
		margin: 0;
		padding: 0;
		display: inline-block;
		width: 100%;
		height: 100%;
		border: 1px solid rgba(0, 0, 0, 0.1);
		box-sizing: border-box;
	}
	.img-container {
		width: 100%;
	}
	.quote-img {
		display: block;
		max-width: 100%;
		max-height: 250px;
		object-fit: contain;
	}
	.codes {
		width: auto;
	}
	.code-pill, .subfig-num {
		display: inline;
		border-radius: 15px;
		padding: 0px 8px;
		margin: 0px 4px;
	}
	.code-pill {
		background-color: lightblue;
	}
	.subfig-num {
		background-color: lightgreen;
	}
	.filter-button-group {
		display: inline;
		flex-direction: column;
	}
	.filter-button-group button {
		border: 1px solid rgba(0, 0, 0, 0.2);
		margin-right: 2px;
		margin-bottom: 2px;
		cursor: pointer;

	}
</style>
